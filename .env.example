# Copy to .env.local. Only NEXT_PUBLIC_* reaches the browser. Never commit .env.local.
# Every variable is validated at boot by src/lib/env.ts; later-stage variables may stay blank until their stage.

# ---- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Public URL of the marketing website (web/). Links to policies, FAQ and contact use it.
NEXT_PUBLIC_MARKETING_URL=https://learnometry-ai.vercel.app

# ---- Supabase (BE-1). `npm run db:start` prints these for the local stack -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler (port 6543) for the app; direct connection for migrations and integration tests.
DATABASE_URL=
DIRECT_DATABASE_URL=

# ---- Jobs and email (BE-2) ---------------------------------------------------
# Not needed with the local Inngest dev server (`npx inngest-cli dev`).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Blank RESEND_API_KEY = emails are written to the console and the dev_outbox table.
RESEND_API_KEY=
EMAIL_FROM=Learnometry <no-reply@localhost>

# ---- AI gateway (BE-6). `mock` needs no keys and is the default everywhere but production ----
AI_PROVIDER_FAST=mock
AI_PROVIDER_STANDARD=mock
AI_PROVIDER_REASONING=mock
AI_MODEL_FAST=
AI_MODEL_STANDARD=
AI_MODEL_REASONING=
AI_FALLBACK_PROVIDER=
ANTHROPIC_API_KEY=
AI_OPENAI_COMPAT_BASE_URL=
AI_OPENAI_COMPAT_API_KEY=
USD_INR=84

# ---- Payments (BE-10): Razorpay TEST keys only outside production ----------------
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_PLUS=
RAZORPAY_PLAN_ID_PRO=

# ---- Guardians and minors (BE-11) -----------------------------------------------
# openssl rand -base64 48
CONSENT_TOKEN_SECRET=
# 32 bytes, base64: openssl rand -base64 32
PII_ENCRYPTION_KEY=
# SMS only after launch gate G10 (DLT). Until then consent is email-only.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ---- Web Push (BE-12). Generate a pair with `npx web-push generate-vapid-keys`. ----
# With no public key, push permission and the "Send a test" button still work; real delivery needs the pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# ---- Observability (no-op when blank) -------------------------------------------------
SENTRY_DSN=
# Adults only; server side only (BE-D47)
POSTHOG_KEY=
POSTHOG_HOST=
